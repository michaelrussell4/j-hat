          "expr": "up{job=\"federate-gateway-clusters-1-and-2\"}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Gateway Federation Link",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "DISCONNECTED" },
                "1": { "color": "green", "text": "FEDERATING ACTIVE" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 5 },
      "id": 5,
      "title": "Simulated Enterprise Cluster Nodes Directory",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "cluster_node_info * on(instance) group_left(role, datacenter) up",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  { "options": { "1": { "text": "ONLINE", "color": "green" }, "0": { "text": "OFFLINE", "color": "red" } }, "type": "value" }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "id": 101,
      "title": "Cross-Cluster Telemetry Metrics Comparison",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 6,
      "title": "CPU Usage Rate by Cluster (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "clamp_max(100 - (avg by (cluster) (rate(node_cpu_seconds_total{mode=\"idle\", cluster=~\"$cluster\"}[1m])) * 100), 100)",
          "legendFormat": "{{cluster}} CPU Utilization",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 7,
      "title": "Memory Utilization by Cluster (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "avg by (cluster) ((1 - (node_memory_MemAvailable_bytes{cluster=~\"$cluster\"} / node_memory_MemTotal_bytes{cluster=~\"$cluster\"})) * 100)",
          "legendFormat": "{{cluster}} Memory Used",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 8,
      "title": "Network Ingress Rate by Cluster (Bytes/sec)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "sum by (cluster) (rate(node_network_receive_bytes_total{cluster=~\"$cluster\", device!~\"lo|veth.*|docker.*|br-.*\"}[1m]))",
          "legendFormat": "{{cluster}} RX",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "Bps"
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 9,
      "title": "Cluster 3 DinD Nested Workload Activity",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "rate(nested_api_requests_total[1m]) or rate(promhttp_metric_handler_requests_total[1m])",
          "legendFormat": "Nested API Request Rate (req/s)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 40
          },
          "unit": "reqps"
        }
      }
    }
  ],
