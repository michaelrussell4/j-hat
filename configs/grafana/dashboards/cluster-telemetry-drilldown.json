{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Selected Node Vitals",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "up{instance=~\"$node.*\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Node Status",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "DOWN" },
                "1": { "color": "green", "text": "HEALTHY" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{instance=~\"$node.*\", mode=\"idle\"}[1m])) * 100)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Current CPU Usage",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "(1 - (node_memory_MemAvailable_bytes{instance=~\"$node.*\"} / node_memory_MemTotal_bytes{instance=~\"$node.*\"})) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Current Memory Usage",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "node_load1{instance=~\"$node.*\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Load Average (1m)",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 4 }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Performance Breakdown Over Time",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "CPU Mode Distribution (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "sum by (mode) (rate(node_cpu_seconds_total{instance=~\"$node.*\"}[1m])) * 100",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "stacking": { "mode": "normal", "group": "A" },
            "fillOpacity": 25
          },
          "unit": "percent"
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "Memory Breakdown (Bytes)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "node_memory_MemTotal_bytes{instance=~\"$node.*\"} - node_memory_MemAvailable_bytes{instance=~\"$node.*\"}",
          "legendFormat": "Used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "node_memory_Cached_bytes{instance=~\"$node.*\"}",
          "legendFormat": "Cached",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "node_memory_MemFree_bytes{instance=~\"$node.*\"}",
          "legendFormat": "Free",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15
          },
          "unit": "bytes"
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 7,
      "title": "Network Traffic (Bytes/s)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "rate(node_network_receive_bytes_total{instance=~\"$node.*\", device!~\"lo|veth.*|docker.*|br-.*\"}[1m])",
          "legendFormat": "Receive ({{device}})",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "rate(node_network_transmit_bytes_total{instance=~\"$node.*\", device!~\"lo|veth.*|docker.*|br-.*\"}[1m])",
          "legendFormat": "Transmit ({{device}})",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "Bps"
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 8,
      "title": "System Load Averages (1m, 5m, 15m)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "node_load1{instance=~\"$node.*\"}",
          "legendFormat": "Load 1m",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "node_load5{instance=~\"$node.*\"}",
          "legendFormat": "Load 5m",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
          "editorMode": "code",
          "expr": "node_load15{instance=~\"$node.*\"}",
          "legendFormat": "Load 15m",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "unit": "short"
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["node-exporter", "telemetry", "drilldown"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "cluster-1", "value": "cluster-1" },
        "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
        "definition": "label_values(up, cluster)",
        "hide": 0,
        "name": "cluster",
        "query": { "query": "label_values(up, cluster)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "c1-node-01:9100", "value": "c1-node-01:9100" },
        "datasource": { "type": "prometheus", "uid": "Prometheus-Cluster3" },
        "definition": "label_values(up{cluster=~\"$cluster\"}, instance)",
        "hide": 0,
        "name": "node",
        "query": { "query": "label_values(up{cluster=~\"$cluster\"}, instance)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "timezone": "browser",
  "title": "Cluster Node Telemetry Drilldown",
  "uid": "cluster-node-drilldown",
  "version": 1
}
